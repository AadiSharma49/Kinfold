# Server-side base URL of the Kinfold API — read by Next.js server code
# and the /api/* proxy routes, so the browser never sees this value.
KINFOLD_API_URL=http://localhost:8000

# Public because it's just a base URL, not a secret — the browser navigates
# here directly for "Sign in with GitHub". NEXT_PUBLIC_ vars are inlined at
# build time, so in production this must be set before the build, with the
# same value as KINFOLD_API_URL (docs/deploy-checklist.md step 10).
NEXT_PUBLIC_KINFOLD_API_URL=http://localhost:8000
