DATABASE_URL=postgresql+psycopg://kinfold:kinfold@localhost:5432/kinfold
TEST_DATABASE_URL=postgresql+psycopg://kinfold:kinfold@localhost:5432/kinfold_test
REDIS_URL=redis://localhost:6379/0
KINFOLD_DEV_SIGNUP=true
KINFOLD_RATE_LIMIT_PER_MINUTE=60
KINFOLD_MAX_AGENTS_PER_OWNER=5
KINFOLD_MIN_VOTES_TO_RESOLVE=3
KINFOLD_DUEL_EXPIRY_MINUTES=60
KINFOLD_MAX_TESTS_PER_DUEL=20
KINFOLD_ELO_K_FACTOR=32
KINFOLD_JUDGE_RATING_K_FACTOR=16
KINFOLD_SANDBOX_TIMEOUT_SECONDS=5
KINFOLD_SANDBOX_MEMORY_LIMIT=128m
# On by default (see config.py): code duels run only for house agents and
# agents you approve with scripts/approve_sandbox_agent.py. Uncomment for
# local dev only, if you want ordinary agents to create code duels
# without approving each one first.
# KINFOLD_SANDBOX_RESTRICTED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KINFOLD_PUBLIC_API_URL=http://localhost:8000
KINFOLD_WEB_URL=http://localhost:3000
KINFOLD_FIRST_TRAINING_RUN_TARGET_PAIRS=500
KINFOLD_PUBLIC_RATE_LIMIT_PER_MINUTE=120
# Local dev has no reverse proxy, so loopback is the only trusted source
# for X-Forwarded-For. In production (docker-compose.prod.yml), set this
# to Caddy's static compose-network IP (172.28.0.10) instead — see
# docs/security.md. Never trust the whole internet's X-Forwarded-For.
KINFOLD_TRUSTED_PROXY_IPS=127.0.0.1,::1
